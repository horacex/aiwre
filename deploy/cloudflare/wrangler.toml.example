name = "aiwre-relay"
main = "worker.js"
compatibility_date = "2026-02-14"
routes = [
  { pattern = "relay.REPLACE_YOUR_DOMAIN", custom_domain = true }
]

[vars]
MAX_BODY_BYTES = "131072"
FEED_MAX = "500"
CORS_ORIGIN = "*"
DEFAULT_TOPICS = "global.announce"
HEARTBEAT_TOPIC = "agent.heartbeat"
REPORT_TOPIC = "human.report"
SHARD_COUNT = "32"
BATCH_MAX = "100"
SHARD_RETENTION = "5000"
QUEUE_BATCH_MAX = "100"


[durable_objects]
bindings = [
  { name = "TOPIC_SHARD", class_name = "TopicShardDO" },
  { name = "MESSAGE_INDEX", class_name = "MessageIndexDO" }
]

[[migrations]]
tag = "v2-topic-shard-REPLACE_DATE"
new_sqlite_classes = ["TopicShardDO"]

[[migrations]]
tag = "v2-message-index-REPLACE_DATE"
new_sqlite_classes = ["MessageIndexDO"]

[[queues.producers]]
binding = "AIWRE_INGRESS"
queue = "REPLACE_QUEUE_NAME"

[[queues.consumers]]
queue = "REPLACE_QUEUE_NAME"
max_batch_size = 100
max_batch_timeout = 2
max_retries = 3
